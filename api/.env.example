# ─── Banco de Dados (SQLite) ──────────────────────────────────
# Caminho do chatbot.db. Relativo à pasta api/ ou absoluto.
# No Docker, aponta para o volume persistente (ver docker-compose.yml).
DB_PATH=db/chatbot.db

# ─── Autenticação ────────────────────────────────────────────
JWT_SECRET=coloque-uma-chave-segura-aqui

# ─── Flask ────────────────────────────────────────────────────
SECRET_KEY=troque-esta-chave-em-producao

# ─── WhatsApp Cloud API ──────────────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=bbt_verify
WHATSAPP_APP_SECRET=
# Sem WHATSAPP_APP_SECRET o webhook é recusado (503). Para testar localmente
# sem o segredo da Meta, mude para false. Nunca use false em produção.
WHATSAPP_REQUIRE_SIGNATURE=true

# ─── Criptografia ────────────────────────────────────────────
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
